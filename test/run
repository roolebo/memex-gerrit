#!/usr/bin/env bash
#
# test/run: tests of memex-gerrit against a fake Gerrit.
#
# test/bin comes first in PATH: its curl and ssh answer from test/fixtures
# and log every request, so no test reaches a network. HOME is a scratch
# directory, so the user's ~/.netrc stays unread.
#

set -e

CURDIR=$(dirname "$(realpath "${BASH_SOURCE[0]}")")
ROOT=$(dirname "$CURDIR")
ADAPTER=$ROOT/memex-gerrit
ADDR=https://review.example.org
DIR=$(mktemp -d)
FAILED=0
# A password the tests look for in curl's arguments
PASSWORD=s3cret

die() {
  echo "$*" >&2
  exit 1
}

usage() {
  cat << EOF
Usage: $0 [TEST...]

Runs the given tests, or all of them:
$(declare -F | cut -d' ' -f3 | grep '^test_' | sed 's/^/  /')
EOF
}

cleanup() {
  rm -rf "$DIR"
}

# Answer METHOD on PATH of ADDR with FIXTURE, - for none, and STATUS
route() {
  printf '%s\t%s\t%s\t%s\n' "$1" "$ADDR/$2" "$3" "${4:-200}" \
    >> "$FAKE_ROUTES"
}

# Use credentials from the environment
login() {
  export GERRIT_USER=u
  export GERRIT_PASSWORD=$PASSWORD
  route GET a/accounts/self account-self.json
}

# Run the adapter on ADDR with ARGS in the working copy; sets OUT, ERR
# and STATUS
call() {
  OUT=$(cd "$TEST_DIR/work" && "$ADAPTER" "$ADDR" "$@" 2> "$TEST_DIR/err") &&
    STATUS=0 || STATUS=$?
  ERR=$(< "$TEST_DIR/err")
}

# Apply a jq FILTER to OUT, one record at a time, or to all with -s
q() {
  jq -c "$@" <<< "$OUT"
}

# Apply a jq FILTER to the logged requests, as an array
log() {
  jq -sc "$1" "$FAKE_LOG"
}

# The logged requests as METHOD URL, one per line
requests() {
  jq -r 'select(.method) | "\(.method) \(.url)"' "$FAKE_LOG"
}

# The body of the first logged request with METHOD
body() {
  log "map(select(.method == \"$1\"))[0].body | fromjson"
}

# What curl read from stdin with -K - for the first request
config() {
  jq -sr '.[0].config' "$FAKE_LOG"
}

# JSON in one line, as jq -c prints it
json() {
  jq -c . <<< "$1"
}

check() {
  [ "$2" == "$3" ] && return
  echo "# $TEST: $1: expected '$3', got '$2'"
  FAILED=$((FAILED + 1))
}

check_has() {
  [[ "$2" == *"$3"* ]] && return
  echo "# $TEST: $1: '$2' lacks '$3'"
  FAILED=$((FAILED + 1))
}

test_capabilities() {
  call discussion capabilities
  check status "$STATUS" 0
  check caps "$(q .)" \
    '{"exact":true,"resolved":true,"drafts":true,"series":true,"votes":true}'
}

test_not_discussion() {
  call tracker capabilities
  check tracker "$STATUS" 2
  call ci runs 1234
  check ci "$STATUS" 2
  check requests "$(requests)" ""
}

test_bad_usage() {
  call discussion frobnicate 1
  check command "$STATUS" 1
  call discussion change
  check "no change" "$STATUS" 1
  OUT=$("$ADAPTER" review.example.org discussion change 1 2>&1) &&
    STATUS=0 || STATUS=$?
  check addr "$STATUS" 1
  check_has message "$OUT" "Not an http(s) URL"
}

CHANGE_PATH="changes/68560?o=ALL_REVISIONS&o=ALL_COMMITS"
CHANGE_PATH+="&o=DETAILED_ACCOUNTS&o=DETAILED_LABELS"

test_change() {
  route GET "$CHANGE_PATH" change.json
  call discussion change 68560
  check status "$STATUS" 0
  check records "$(q -s length)" 1
  check envelope "$(q '[.id, .source, .role, .kind, .notes]')" \
    '["68560","https://review.example.org","discussion","change",{}]'
  check basis "$(q -r .basis)" \
    "3333333333333333333333333333333333333333 2026-09-06 22:10:04.000000000"
  check links "$(q .links)" "$(json '[["change", "68560"],
    ["change-id", "Ie4ebe32c2f0290e055d88530174d2a557c09ad3a"]]')"
  check title "$(q .data.title)" \
    '"PRJ-930 doc: Fix typos in OSD API documentation"'
  check url "$(q .data.url)" \
    '"https://review.example.org/c/fs/project/+/68560"'
  check status "$(q .data.status)" '"open"'
  check owner "$(q .data.owner)" "$(json '{"name": "Alice Author",
    "email": "alice@example.org", "username": "alice", "me": false}')"
  check current "$(q .data.current)" '"3"'
  check_has message "$(q -r .data.message)" "Change-Id: Ie4ebe32c"
  check requests "$(requests)" "GET $ADDR/$CHANGE_PATH"
}

# Revisions come oldest first, whatever order Gerrit's map has
test_change_revisions() {
  route GET "$CHANGE_PATH" change.json
  call discussion change 68560
  check ids "$(q '[.data.revisions[].id]')" '["1","2","3"]'
  check second "$(q '.data.revisions[1]')" "$(json '{"id": "2",
    "commit": "2222222222222222222222222222222222222222",
    "parents": ["8888888888888888888888888888888888888888"],
    "fetch": "refs/changes/60/68560/2",
    "uploader": {"name": "Dan Gatekeeper", "email": "dan@example.org",
      "username": "dan", "me": false},
    "created": "2026-09-01T18:02:04Z"}')"
}

# Only votes other than 0, a missing value being 0
test_change_votes() {
  route GET "$CHANGE_PATH" change.json
  call discussion change 68560
  check votes "$(q '[.data.votes[] | [.label, .value, .by.username]]')" \
    '[["Verified",1,"ci"],["Code-Review",2,"bob"],["Code-Review",-1,"dan"]]'
  check "no email" "$(q '.data.votes[0].by.email')" null
}

test_change_http_error() {
  route GET "$CHANGE_PATH" - 404
  call discussion change 68560
  check status "$STATUS" 1
  check out "$OUT" ""
  check_has stderr "$ERR" "Cannot GET $ADDR/$CHANGE_PATH"
}

test_locate() {
  route GET "changes/?q=commit:3333333" locate.json
  route GET "$CHANGE_PATH" change.json
  call discussion locate 3333333
  check status "$STATUS" 0
  check id "$(q .id)" '"68560"'
}

test_locate_none() {
  route GET "changes/?q=commit:abcdef0" locate-none.json
  call discussion locate abcdef0
  check status "$STATUS" 1
  check_has stderr "$ERR" "No change has commit abcdef0"
}

RELATED_PATH=changes/68560/revisions/current/related

# Gerrit lists related changes tip first; a series goes base to tip
test_series() {
  route GET "$RELATED_PATH" related.json
  route GET "${CHANGE_PATH/68560/68559}" change-68559.json
  route GET "$CHANGE_PATH" change.json
  route GET "${CHANGE_PATH/68560/68561}" change-68561.json
  call discussion series 68560
  check status "$STATUS" 0
  check ids "$(q -s '[.[].id]')" '["68559","68560","68561"]'
  check statuses "$(q -s '[.[].data.status]')" \
    '["merged","open","abandoned"]'
  check fetch "$(q -s '.[0].data.revisions[0].fetch')" \
    '"refs/changes/59/68559/1"'
}

test_series_alone() {
  route GET "$RELATED_PATH" related-none.json
  route GET "$CHANGE_PATH" change.json
  call discussion series 68560
  check status "$STATUS" 0
  check ids "$(q -s '[.[].id]')" '["68560"]'
}

# The thread of comment ID in OUT
thread() {
  q "select(.id == \"$1\")"
}

test_threads() {
  route GET changes/68560/comments comments.json
  call discussion threads 68560
  check status "$STATUS" 0
  check ids "$(q -s '[.[].id] | sort')" '["a1","b1","c1","d1","e1","f2"]'
  check envelope "$(thread c1 | jq -c '[.source, .role, .kind, .links]')" \
    "$(json '["https://review.example.org", "discussion", "thread",
      [["change", "68560"]]]')"
  check comment "$(thread c1 | jq -c '.data.comments[0]')" "$(json '{
    "id": "c1",
    "author": {"name": "Dan Gatekeeper", "email": "dan@example.org",
      "username": "dan", "me": false},
    "revision": "2", "text": "Looks good otherwise.",
    "created": "2026-09-02T12:00:00Z", "reply_to": null, "draft": false}')"
}

test_threads_anchors() {
  route GET changes/68560/comments comments.json
  call discussion threads 68560
  check change "$(thread c1 | jq -c .data.anchor)" '{"on":"change"}'
  check message "$(thread b1 | jq -c .data.anchor)" '{"on":"message"}'
  check "message lines" "$(thread a1 | jq -c .data.anchor)" "$(json '{
    "on": "message", "start": 9, "end": 9}')"
  check file "$(thread e1 | jq -c .data.anchor)" \
    '{"on":"file","path":"src/b.c"}'
  check line "$(thread f2 | jq -c .data.anchor)" \
    '{"on":"lines","path":"src/b.c","side":"revision","start":7,"end":7}'
  check range "$(thread d1 | jq -c .data.anchor)" "$(json '{
    "on": "lines", "path": "src/a.c", "side": "base", "start": 10,
    "end": 12, "start_col": 5, "end_col": 9}')"
}

# Replies join their root however Gerrit orders them, oldest first
test_threads_replies() {
  route GET changes/68560/comments comments.json
  call discussion threads 68560
  check order "$(thread d1 | jq -c '[.data.comments[] | [.id, .reply_to]]')" \
    '[["d1",null],["d2","d1"],["d3","d2"]]'
  check revision "$(thread d1 | jq -c .data.revision)" '"2"'
  check basis "$(thread d1 | jq -c .basis)" '"2:d3"'
  check orphan "$(thread f2 | jq -c '[.data.comments[] | .reply_to]')" \
    '["gone"]'
}

# The last comment says whether a thread is resolved
test_threads_resolved() {
  route GET changes/68560/comments comments.json
  call discussion threads 68560
  check "reply resolves" "$(thread a1 | jq .data.resolved)" true
  check "reply reopens" "$(thread d1 | jq .data.resolved)" false
  check unresolved "$(thread b1 | jq .data.resolved)" false
  check resolved "$(thread c1 | jq .data.resolved)" true
}

test_netrc() {
  printf 'machine review.example.org login u password %s\n' "$PASSWORD" \
    > "$HOME/.netrc"
  route GET a/accounts/self account-self.json
  route GET "a/$CHANGE_PATH" change.json
  call discussion change 68560
  check status "$STATUS" 0
  check auth "$(log '[.[].auth] | unique')" '["netrc"]'
  check owner "$(q .data.owner.me)" true
}

test_netrc_other_host() {
  printf 'machine review.example.com login u password %s\n' "$PASSWORD" \
    > "$HOME/.netrc"
  route GET "$CHANGE_PATH" change.json
  call discussion change 68560
  check status "$STATUS" 0
  check auth "$(log '[.[].auth] | unique')" '["none"]'
}

# The password goes on stdin; requests go to /a/
test_credentials() {
  login
  route GET "a/$CHANGE_PATH" change.json
  call discussion change 68560
  check status "$STATUS" 0
  check requests "$(requests)" \
    "GET $ADDR/a/accounts/self"$'\n'"GET $ADDR/a/$CHANGE_PATH"
  check auth "$(log '[.[].auth] | unique')" '["stdin"]'
  check config "$(config)" "user = \"u:$PASSWORD\""
  check args "$(log "[.[].args[] | select(contains(\"$PASSWORD\"))]")" '[]'
  check owner "$(q .data.owner.me)" true
  check voter "$(q '[.data.votes[].by.me]')" '[false,false,false]'
}

# curl reads \ and " in a quoted config value as escapes
test_credentials_quoted() {
  login
  export GERRIT_PASSWORD='p"\q'
  route GET "a/$CHANGE_PATH" change.json
  call discussion change 68560
  check status "$STATUS" 0
  check config "$(config)" 'user = "u:p\"\\q"'
}

test_credentials_error() {
  export GERRIT_USER=u
  export GERRIT_PASSWORD=$PASSWORD
  route GET a/accounts/self - 401
  call discussion change 68560
  check status "$STATUS" 1
  check_has stderr "$ERR" "Cannot GET $ADDR/a/accounts/self"
}

# capabilities is the same for every server: it sends no request
test_capabilities_offline() {
  export GERRIT_USER=u
  export GERRIT_PASSWORD=$PASSWORD
  call discussion capabilities
  check status "$STATUS" 0
  check requests "$(requests)" ""
}

# Make the working copy a repository with a REMOTE
remote() {
  git -C "$TEST_DIR/work" init -q
  git -C "$TEST_DIR/work" remote add origin "$1"
}

# Without credentials the user is who the ssh:// remote logs in as
test_me_ssh() {
  remote ssh://alice@review.example.org:29418/fs/project
  export FAKE_SSH_REPLY=ssh-query.json
  route GET "$CHANGE_PATH" change.json
  call discussion change 68560
  check status "$STATUS" 0
  check ssh "$(log '[.[].ssh | select(.)]')" "$(json '[["-T", "-o",
    "BatchMode=yes", "ssh://alice@review.example.org:29418",
    "gerrit", "query", "--format=JSON", "limit:1", "owner:self"]]')"
  check owner "$(q .data.owner.me)" true
  check reviewer "$(q '[.data.votes[].by.me]')" '[false,false,false]'
}

test_me_ssh_fails() {
  remote ssh://alice@review.example.org:29418/fs/project
  route GET "$CHANGE_PATH" change.json
  call discussion change 68560
  check status "$STATUS" 0
  check owner "$(q .data.owner.me)" false
}

test_me_ssh_other_host() {
  remote ssh://alice@review.example.com:29418/fs/project
  export FAKE_SSH_REPLY=ssh-query.json
  route GET "$CHANGE_PATH" change.json
  call discussion change 68560
  check status "$STATUS" 0
  check ssh "$(log '[.[].ssh | select(.)]')" '[]'
  check owner "$(q .data.owner.me)" false
}

# Drafts carry no author: it is the user
test_drafts() {
  login
  route GET a/changes/68560/drafts drafts.json
  call discussion drafts 68560
  check status "$STATUS" 0
  check ids "$(q -s '[.[].id] | sort')" '["dr1","dr2"]'
  check author "$(q -s '[.[].data.comments[0].author] | unique')" \
    "$(json '[{"name": "Alice Author", "email": "alice@example.org",
      "username": "alice", "me": true}]')"
  check draft "$(q -s '[.[].data.comments[0].draft] | unique')" '[true]'
  check dr1 "$(q 'select(.id == "dr1") | .data
    | [.anchor, .revision, .resolved]')" "$(json '[{"on": "lines",
      "path": "src/a.c", "side": "revision", "start": 5, "end": 5},
    "3", false]')"
  check dr2 "$(q 'select(.id == "dr2") | .data | [.anchor, .resolved]')" \
    '[{"on":"change"},true]'
  check basis "$(q 'select(.id == "dr1") | .basis')" \
    '"3:dr1:2026-10-20 10:00:00.000000000"'
}

# Writes refuse to run anonymously, before any request
test_writes_need_credentials() {
  call discussion drafts 68560
  check drafts "$STATUS" 1
  check_has stderr "$ERR" "Drafts need GERRIT_USER and GERRIT_PASSWORD"
  call discussion draft 68560 <<< '{"anchor": {"on": "change"},
    "revision": "3", "text": "x"}'
  check draft "$STATUS" 1
  call discussion discard 68560 dr1
  check discard "$STATUS" 1
  call discussion publish 68560 <<< '{"message": "x"}'
  check publish "$STATUS" 1
  check requests "$(requests)" ""
}

# A reply takes its anchor and patch set from the comment it replies to
test_draft_reply() {
  login
  route GET a/changes/68560/comments comments.json
  route PUT a/changes/68560/revisions/2/drafts draft-reply.json
  call discussion draft 68560 <<< '{"reply_to": "d3",
    "text": "Fixed in the next patch set", "resolved": true}'
  check status "$STATUS" 0
  check put "$(requests | grep PUT)" \
    "PUT $ADDR/a/changes/68560/revisions/2/drafts"
  check body "$(body PUT)" "$(json '{"path": "src/a.c", "line": 12,
    "range": {"start_line": 10, "start_character": 4, "end_line": 12,
      "end_character": 8},
    "side": "PARENT", "in_reply_to": "d3", "unresolved": false,
    "message": "Fixed in the next patch set"}')"
  check json "$(log '[.[] | select(.method == "PUT") | .args
    | index("Content-Type: application/json") != null]')" '[true]'
  check id "$(q .id)" '"dr3"'
  check comment "$(q '.data.comments[0] | [.author.me, .draft, .reply_to,
    .revision]')" '[true,true,"d3","2"]'
  check resolved "$(q .data.resolved)" true
}

# Without resolved, a reply keeps the thread as it was
test_draft_reply_unchanged() {
  login
  route GET a/changes/68560/comments comments.json
  route PUT a/changes/68560/revisions/1/drafts draft-reply.json
  call discussion draft 68560 <<< '{"reply_to": "a2", "text": "Thanks"}'
  check status "$STATUS" 0
  check body "$(body PUT)" "$(json '{"path": "/COMMIT_MSG", "line": 9,
    "in_reply_to": "a2", "unresolved": false, "message": "Thanks"}')"
}

test_draft_reply_unknown() {
  login
  route GET a/changes/68560/comments comments.json
  call discussion draft 68560 <<< '{"reply_to": "zz", "text": "x"}'
  check status "$STATUS" 1
  check_has stderr "$ERR" "No comment zz"
  check put "$(requests | grep -c PUT)" 0
}

# Columns become a range: Gerrit counts characters from 0
test_draft_thread() {
  login
  route PUT a/changes/68560/revisions/3/drafts draft-new.json
  call discussion draft 68560 <<< '{"anchor": {"on": "lines",
    "path": "src/a.c", "side": "base", "start": 20, "end": 22,
    "start_col": 1, "end_col": 6}, "revision": "3",
    "text": "Why not a mutex?"}'
  check status "$STATUS" 0
  check put "$(requests | grep PUT)" \
    "PUT $ADDR/a/changes/68560/revisions/3/drafts"
  check comments "$(requests | grep -c comments)" 0
  check body "$(body PUT)" "$(json '{"path": "src/a.c", "line": 22,
    "range": {"start_line": 20, "start_character": 0, "end_line": 22,
      "end_character": 5},
    "side": "PARENT", "unresolved": true, "message": "Why not a mutex?"}')"
  check anchor "$(q .data.anchor)" "$(json '{"on": "lines",
    "path": "src/a.c", "side": "base", "start": 20, "end": 22,
    "start_col": 1, "end_col": 6}')"
  check revision "$(q .data.revision)" '"3"'
}

# Draft TEXT on ANCHOR of patch set 3; prints the body of the PUT
draft_on() {
  : > "$FAKE_LOG"
  call discussion draft 68560 <<< "{\"anchor\": $1, \"revision\": \"3\",
    \"text\": \"t\", \"resolved\": true}"
  body PUT
}

test_draft_anchors() {
  login
  route PUT a/changes/68560/revisions/3/drafts draft-new.json
  check change "$(draft_on '{"on": "change"}')" \
    '{"path":"/PATCHSET_LEVEL","unresolved":false,"message":"t"}'
  check message "$(draft_on '{"on": "message"}')" \
    '{"path":"/COMMIT_MSG","unresolved":false,"message":"t"}'
  check file "$(draft_on '{"on": "file", "path": "src/a.c"}')" \
    '{"path":"src/a.c","unresolved":false,"message":"t"}'
  check lines "$(draft_on '{"on": "lines", "path": "src/a.c",
    "side": "revision", "start": 4, "end": 4}')" \
    '{"path":"src/a.c","line":4,"unresolved":false,"message":"t"}'
}

# A draft is deleted on the patch set it was written on
test_discard() {
  login
  route GET a/changes/68560/drafts drafts.json
  route DELETE a/changes/68560/revisions/3/drafts/dr1 - 204
  call discussion discard 68560 dr1
  check status "$STATUS" 0
  check out "$OUT" ""
  check delete "$(requests | grep DELETE)" \
    "DELETE $ADDR/a/changes/68560/revisions/3/drafts/dr1"
}

test_discard_unknown() {
  login
  route GET a/changes/68560/drafts drafts-none.json
  call discussion discard 68560 dr1
  check status "$STATUS" 1
  check_has stderr "$ERR" "No draft dr1 on 68560"
  check delete "$(requests | grep -c DELETE)" 0
}

test_publish() {
  login
  route POST a/changes/68560/revisions/current/review review.json
  call discussion publish 68560 <<< '{"message": "Thanks",
    "votes": {"Code-Review": 1, "Verified": -1}}'
  check status "$STATUS" 0
  check out "$OUT" ""
  check post "$(requests | grep POST)" \
    "POST $ADDR/a/changes/68560/revisions/current/review"
  check body "$(body POST)" "$(json '{"drafts": "PUBLISH_ALL_REVISIONS",
    "message": "Thanks", "labels": {"Code-Review": 1, "Verified": -1}}')"
}

test_publish_drafts_only() {
  login
  route POST a/changes/68560/revisions/current/review review.json
  call discussion publish 68560 <<< '{"message": null, "votes": {}}'
  check status "$STATUS" 0
  check body "$(body POST)" '{"drafts":"PUBLISH_ALL_REVISIONS","labels":{}}'
}

test_publish_error() {
  login
  route POST a/changes/68560/revisions/current/review - 409
  call discussion publish 68560 <<< '{"message": "x"}'
  check status "$STATUS" 1
  check_has stderr "$ERR" \
    "Cannot POST $ADDR/a/changes/68560/revisions/current/review"
}

run() {
  local failed=$FAILED
  local unexpected
  TEST=$1
  TEST_DIR=$DIR/$1
  mkdir -p "$TEST_DIR/work" "$TEST_DIR/home"
  export HOME=$TEST_DIR/home
  export FAKE_LOG=$TEST_DIR/log
  export FAKE_ROUTES=$TEST_DIR/routes
  : > "$FAKE_LOG"
  : > "$FAKE_ROUTES"
  "$1" < /dev/null
  unexpected=$(jq -r 'select(.unexpected) | "\(.method) \(.url)"' "$FAKE_LOG")
  check "unexpected requests" "$unexpected" ""
  unset GERRIT_USER GERRIT_PASSWORD FAKE_SSH_REPLY
  if [ $FAILED -eq $failed ]; then
    echo "ok $1"
  else
    echo "not ok $1"
  fi
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
command -v jq > /dev/null || die "jq is not installed"
trap cleanup EXIT
export FAKE_FIXTURES=$CURDIR/fixtures
export PATH=$CURDIR/bin:$PATH
unset GERRIT_USER GERRIT_PASSWORD FAKE_SSH_REPLY
# The working copy is no repository unless a test makes it one
export GIT_CEILING_DIRECTORIES=$DIR

TESTS=("$@")
[ $# -gt 0 ] || TESTS=($(declare -F | cut -d' ' -f3 | grep '^test_'))
for test in "${TESTS[@]}"; do
  declare -F "$test" > /dev/null || die "No such test: $test"
  run "$test"
done
[ $FAILED -eq 0 ] || die "$FAILED failed"
