#!/usr/bin/env bash
#
# memex-gerrit: memex adapter for the discussion role in Gerrit.
#
#   memex-gerrit ADDR ROLE COMMAND [ARGUMENTS]
#
# README.md specifies the mapping. Credentials come from GERRIT_USER and
# GERRIT_PASSWORD (the HTTP password), e.g. set by withkeys, or else from
# ~/.netrc for ADDR's host; without them only reading works, and the user
# is found through the working copy's ssh:// remote on that host. Never
# prompts. Drafts and publishing need credentials.
#

set -e

die() {
  echo "$*" >&2
  exit 1
}

unsupported() {
  echo "Not supported yet: $1" >&2
  exit 2
}

usage() {
  cat << EOF
Usage: $0 ADDR discussion capabilities
       $0 ADDR discussion locate COMMIT
       $0 ADDR discussion change CHANGE
       $0 ADDR discussion series CHANGE
       $0 ADDR discussion threads CHANGE
       $0 ADDR discussion drafts CHANGE
       $0 ADDR discussion draft CHANGE < DRAFT
       $0 ADDR discussion discard CHANGE ID
       $0 ADDR discussion publish CHANGE < MESSAGE_AND_VOTES
EOF
}

HOST_RE='^https?://([^/:]+)'

# Calls a REST path with METHOD and an optional JSON BODY; prints the
# reply with Gerrit's )]}' line stripped
call() {
  local url=$ADDR/$2
  local reply
  local user
  local args=(-fsS -X "$1")
  [ -n "$AUTH" ] && url=$ADDR/a/$2
  [ -n "$3" ] && args+=(-H 'Content-Type: application/json'
    --data-binary "$3")
  # The password goes to curl on stdin, not on its command line
  if [ "$AUTH" == env ]; then
    # curl's config reads \ and " in a quoted value as escapes
    user=$(printf '%s:%s' "$GERRIT_USER" "$GERRIT_PASSWORD" |
      sed 's/[\\"]/\\&/g')
    reply=$(printf 'user = "%s"\n' "$user" |
      curl "${args[@]}" -K - "$url") || die "Cannot $1 $url"
  elif [ "$AUTH" == netrc ]; then
    reply=$(curl "${args[@]}" --netrc "$url") || die "Cannot $1 $url"
  else
    reply=$(curl "${args[@]}" "$url") || die "Cannot $1 $url"
  fi
  tail -n +2 <<< "$reply"
}

# GET a REST path; prints the JSON
get() {
  call GET "$1"
}

# The user's account: drafts carry no author
me() {
  get accounts/self
}

need_auth() {
  [ -n "$AUTH" ] || die "Drafts need GERRIT_USER and GERRIT_PASSWORD," \
    "or ~/.netrc for $HOST"
}

# Prints ssh://[USER@]HOST[:PORT] of the working copy's first ssh://
# remote on HOST
ssh_remote() {
  local url
  for url in $(git remote -v 2> /dev/null | cut -f2 | cut -d' ' -f1); do
    if [[ "$url" =~ ^ssh://([^@/]*@)?$HOST(:[0-9]+)?/ ]]; then
      echo "${BASH_REMATCH[0]%/}"
      return
    fi
  done
}

# The user as JSON: the account id with credentials, else the username
# the working copy's SSH remote logs in as, else null
self() {
  local account
  local remote
  if [ -n "$AUTH" ]; then
    account=$(get accounts/self) || exit 1
    jq '._account_id' <<< "$account"
    return
  fi
  remote=$(ssh_remote)
  if [ -z "$remote" ]; then
    echo null
    return
  fi
  account=$(ssh -T -o BatchMode=yes "$remote" gerrit query \
    --format=JSON limit:1 owner:self 2> /dev/null) || true
  jq -s '[.[].owner.username // empty][0] // null' <<< "$account"
}

# jq definitions shared by the commands
JQ_DEFS='
def time: sub(" "; "T") | sub("\\..*"; "") + "Z";
def person: {
  name: (.name // .username // ""),
  email: (.email // null),
  username: (.username // null),
  me: (if ($self | type) == "string" then .username == $self
    else ._account_id == $self end)
};
def record($kind; $id; $basis; $links; $data): {
  id: $id, source: $addr, role: "discussion", kind: $kind,
  basis: $basis, links: $links, data: $data, notes: {}
};
def span:
  if .range then {start: .range.start_line, end: .range.end_line,
      start_col: (.range.start_character + 1),
      end_col: (.range.end_character + 1)}
    elif .line then {start: .line, end: .line}
    else {} end;
def anchor:
  (if .side == "PARENT" then "base" else "revision" end) as $side
  | if .path == "/PATCHSET_LEVEL" then {on: "change"}
    elif .path == "/COMMIT_MSG" then {on: "message"} + span
    elif .range or .line then {on: "lines", path: .path, side: $side}
      + span
    else {on: "file", path: .path} end;
def comment($draft): {
  id: .id,
  author: (.author // $me | person),
  revision: (.patch_set | tostring),
  text: .message,
  created: (.updated | time),
  reply_to: (.in_reply_to // null),
  draft: $draft
};
def draft_thread: record("thread"; .id;
  "\(.patch_set):\(.id):\(.updated)"; [["change", $change]];
  {
    anchor: anchor,
    revision: (.patch_set | tostring),
    resolved: ((.unresolved // false) | not),
    comments: [comment(true)]
  });
'

CHANGE_OPTIONS='o=ALL_REVISIONS&o=ALL_COMMITS&o=DETAILED_ACCOUNTS'
CHANGE_OPTIONS+='&o=DETAILED_LABELS'

change() {
  local json
  json=$(get "changes/$1?$CHANGE_OPTIONS") || exit 1
  jq -c --arg addr "$ADDR" --argjson self "$SELF" "$JQ_DEFS"'
      .current_revision as $cur
      | record("change"; (._number | tostring);
          ($cur + " " + .updated);
          [["change", (._number | tostring)], ["change-id", .change_id]];
          {
            title: .subject,
            url: ($addr + "/c/" + .project + "/+/" + (._number | tostring)),
            status: ({NEW: "open", MERGED: "merged",
                      ABANDONED: "abandoned"}[.status] // "open"),
            owner: (.owner | person),
            revisions: ([.revisions | to_entries[] | {
              id: (.value._number | tostring),
              commit: .key,
              parents: [.value.commit.parents[]?.commit],
              fetch: .value.ref,
              uploader: (.value.uploader | person),
              created: (.value.created | time)
            }] | sort_by(.id | tonumber)),
            current: (.revisions[$cur]._number | tostring),
            votes: [.labels // {} | to_entries[] | .key as $label
              | .value.all[]? | select((.value // 0) != 0)
              | {label: $label, value: .value, by: person}],
            message: .revisions[$cur].commit.message
          })' <<< "$json"
}

locate() {
  local number
  local json
  json=$(get "changes/?q=commit:$1") || exit 1
  number=$(jq '.[0]._number // empty' <<< "$json")
  [ -n "$number" ] || die "No change has commit $1"
  change "$number"
}

series() {
  local numbers
  local number
  local json
  json=$(get "changes/$1/revisions/current/related") || exit 1
  numbers=$(jq -r '[.changes[]._change_number] | reverse | .[]' <<< "$json")
  [ -n "$numbers" ] || numbers=$1
  for number in $numbers; do
    change "$number"
  done
}

threads() {
  local json
  json=$(get "changes/$1/comments") || exit 1
  jq -c --arg addr "$ADDR" --argjson self "$SELF" --arg change "$1" \
    --argjson me null "$JQ_DEFS"'
      [to_entries[] | .key as $path | .value[] | . + {path: $path}]
      | (map({key: .id, value: .}) | from_entries) as $by_id
      | def root: if .in_reply_to and $by_id[.in_reply_to]
          then $by_id[.in_reply_to] | root else . end;
      group_by(root.id)[]
      | sort_by(.updated)
      | (map(select(.in_reply_to == null or
          ($by_id[.in_reply_to] | not)))[0] // .[0]) as $root
      | ((.[-1].patch_set | tostring) + ":" + .[-1].id) as $basis
      | record("thread"; $root.id; $basis;
          [["change", $change]];
          {
            anchor: ($root | anchor),
            revision: ($root.patch_set | tostring),
            resolved: ((.[-1].unresolved // false) | not),
            comments: [.[] | comment(false)]
          })' <<< "$json"
}

# Prints the user's drafts on CHANGE, each as a thread of one comment
drafts() {
  local json
  need_auth
  json=$(get "changes/$1/drafts") || exit 1
  jq -c --arg addr "$ADDR" --argjson self "$SELF" --arg change "$1" \
    --argjson me "$(me)" "$JQ_DEFS"'to_entries[] | .key as $path | .value[]
      | . + {path: $path} | draft_thread' <<< "$json"
}

# Adds a draft on CHANGE from the JSON object on stdin: a reply to a
# comment, or a new thread on an anchor of a revision
draft() {
  local input
  local comments
  local body
  local revision
  local json
  need_auth
  input=$(cat)
  if [ "$(jq -r '.reply_to // empty' <<< "$input")" ]; then
    comments=$(get "changes/$1/comments") || exit 1
  else
    comments='{}'
  fi
  # The draft's revision, then its CommentInput
  # A change's comments can be longer than an argument may be
  body=$(jq -c --slurpfile comments <(echo "$comments") '
    $comments[0] as $comments
    | (.reply_to // null) as $to
    | (if $to then [$comments | to_entries[] | .key as $path
        | .value[] | select(.id == $to) | . + {path: $path}][0]
        // error("No comment \($to)") else null end) as $parent
    | (if $parent then $parent | {path, line, range, side,
        in_reply_to: .id, patch_set, unresolved}
      else .anchor as $a
        | if $a.on == "change" then {path: "/PATCHSET_LEVEL"}
          elif $a.on == "file" then {path: $a.path}
          else {path: (if $a.on == "message" then "/COMMIT_MSG"
              else $a.path end)}
            + if $a.start_col then {line: $a.end, range: {
                start_line: $a.start, start_character: ($a.start_col - 1),
                end_line: $a.end, end_character: ($a.end_col - 1)}}
              elif $a.end then {line: $a.end} else {} end end
        + (if $a.side == "base" then {side: "PARENT"} else {} end)
        + {patch_set: (.revision | tonumber), unresolved: true} end)
    + {message: .text}
    + (if has("resolved") then {unresolved: (.resolved | not)}
      else {} end)
    | with_entries(select(.value != null))' <<< "$input") || exit 1
  revision=$(jq -r '.patch_set' <<< "$body")
  json=$(call PUT "changes/$1/revisions/$revision/drafts" \
    "$(jq -c 'del(.patch_set)' <<< "$body")") || exit 1
  jq -c --arg addr "$ADDR" --argjson self "$SELF" --arg change "$1" \
    --argjson body "$body" --argjson me "$(me)" "$JQ_DEFS"'
    {path: $body.path, patch_set: $body.patch_set} + . | draft_thread' \
    <<< "$json"
}

# Deletes the draft ID on CHANGE
discard() {
  local json
  local revision
  need_auth
  json=$(get "changes/$1/drafts") || exit 1
  revision=$(jq -r --arg id "$2" \
    '[.[][] | select(.id == $id)][0].patch_set // empty' <<< "$json")
  [ -n "$revision" ] || die "No draft $2 on $1"
  call DELETE "changes/$1/revisions/$revision/drafts/$2" > /dev/null
}

# Publishes the drafts on CHANGE, with a message and votes from the JSON
# object on stdin
publish() {
  local body
  need_auth
  body=$(jq -c '{drafts: "PUBLISH_ALL_REVISIONS"}
    + (if .message then {message} else {} end)
    + (if .votes then {labels: .votes} else {} end)') || exit 1
  call POST "changes/$1/revisions/current/review" "$body" > /dev/null
}

if [ "$1" == "-h" -o "$1" == "--help" ]; then
  usage
  exit 0
fi
[ $# -ge 3 ] || die "$(usage)"
if [ "$2" != discussion ]; then
  echo "Not a $2 adapter" >&2
  exit 2
fi
# Drop ROLE: the commands below take ADDR COMMAND [ARGUMENTS]
set -- "$1" "${@:3}"

ADDR=${1%/}
[[ "$ADDR" =~ $HOST_RE ]] || die "Not an http(s) URL: $1"
HOST=${BASH_REMATCH[1]}
if [ -n "$GERRIT_USER" -a -n "$GERRIT_PASSWORD" ]; then
  AUTH=env
elif grep -qs "machine $HOST\b" ~/.netrc; then
  AUTH=netrc
fi

case "$2" in
  capabilities)
    echo '{"exact": true, "resolved": true, "drafts": true,' \
      '"series": true, "votes": true}'
    ;;
  locate | change | series | threads | drafts | draft)
    [ $# -eq 3 ] || die "$(usage)"
    SELF=$(self)
    "$2" "$3"
    ;;
  publish)
    [ $# -eq 3 ] || die "$(usage)"
    publish "$3"
    ;;
  discard)
    [ $# -eq 4 ] || die "$(usage)"
    discard "$3" "$4"
    ;;
  *)
    die "$(usage)"
    ;;
esac
